{
  "name": "popote-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src relais --fileParallelism=false",
    "e2e": "playwright test",
    "couverture": "rm -rf .nyc_output coverage && COUVERTURE=1 npm run build -- --mode development && COUVERTURE=1 npx playwright test && npx nyc report --reporter=text --report-dir coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "motion": "^13.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^17.4.2",
    "nyc": "^18.0.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
