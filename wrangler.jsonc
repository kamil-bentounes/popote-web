{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "popote-web-essai",
  "main": "relais/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "essai.notre-popote.fr", "custom_domain": true }],
  "vars": {
    // Le conteneur d'essai chez Scaleway (Paris). Il refuse tout appel sans l'en-tête secret du relais.
    "API_ORIGIN": "https://popoteessaib8c709c6-api.functions.fnc.fr-par.scw.cloud",
    "ENVIRONNEMENT": "essai",
    "CSP_MODE": "report-only",
    "CSP": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests"
  }
}
